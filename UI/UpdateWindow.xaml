<Window x:Class="FlowWheel.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource UpdateAvailableTitle}"
        Height="520" Width="560"
        MinHeight="380" MinWidth="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Border Background="{DynamicResource Brush.Card.Background}"
            CornerRadius="12"
            Margin="16"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Text="{DynamicResource UpdateAvailableTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="22,20,22,4"/>

            <TextBlock x:Name="VersionInfoText"
                       Grid.Row="1"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="22,0,22,12"/>

            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Control.Background}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="22,0,22,0">
                <Grid>
                    <wv2:WebView2 x:Name="NotesBrowser"
                                  Visibility="Collapsed"/>

                    <ScrollViewer x:Name="FallbackScroll"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14">
                        <TextBlock x:Name="FallbackText"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontSize="13"
                                   LineHeight="20"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="22,18,22,18">
                <Button x:Name="LaterButton"
                        Content="{DynamicResource BtnUpdateLater}"
                        Style="{StaticResource ModernButton}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Brush.Control.Border}"
                        BorderThickness="1"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Padding="18,8"
                        Margin="0,0,10,0"
                        Click="LaterButton_Click"/>
                <Button x:Name="UpdateButton"
                        Content="{DynamicResource BtnUpdateNow}"
                        Style="{StaticResource ModernButton}"
                        Padding="18,8"
                        Click="UpdateButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
